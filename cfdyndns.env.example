# Cloudflare API token with Zone:Read and DNS:Edit for the zone.
# Create at https://dash.cloudflare.com/profile/api-tokens ("Edit zone DNS" template).
CF_API_TOKEN=

# The zone (domain) the records live in. Set either the name or the ID.
CF_ZONE_NAME=example.com
#CF_ZONE_ID=

# Comma-separated list of full record names to keep updated.
CF_RECORD_NAMES=home.example.com

# A for IPv4 (default) or AAAA for IPv6.
#CF_RECORD_TYPE=A

# How often to check the public IP (Go duration, minimum 30s). Default 5m.
#CF_INTERVAL=5m

# Only used when a record doesn't exist yet and has to be created.
# Existing records keep their TTL and proxy settings.
#CF_TTL=1
#CF_PROXIED=false
